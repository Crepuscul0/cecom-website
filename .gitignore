/.next
/node_modules
scripts/node_modules/
.env.local
standalone/
*.zip

# Build artifacts and logs
*.log
logs/
.DS_Store
.vscode/settings.json
tsconfig.tsbuildinfo
.htaccess-for-parent
cpanel-deployment-package/
reports/
DEPLOY-INSTRUCTIONS-*.txt

# Sensitive files
.env
.env.production
.env.staging

# cPanel deployment (keep these tracked)
!server.js
!.htaccess
!.cpanel.yml

# Documentation (ignore all root .md files by default)
/*.md

# Explicitly include specific root MD files we want to keep
!/README.md

# Documentation in subdirectories (ignore by default)
/docs/troubleshooting/*
/docs/development/*

# Explicitly include specific documentation we want to keep
!/docs/README.md
!/docs/deployment/guides/CPANEL-DEPLOYMENT-GUIDE.md
!/docs/deployment/guides/FTP-DEPLOYMENT-GUIDE.md

# Development artifacts
/dist
/coverage
.nyc_output
