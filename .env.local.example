# Copy this to .env.local and fill in your values

# Supabase Configuration (Required - you should already have these)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Configuration (Required for the email system to work)
ADMIN_EMAIL=admin@cecom.do

# Corporate SMTP (Optional - for production email sending)
# Leave these empty for now - the system will work with console logging
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CECOM
SMTP_FROM_EMAIL=info@cecom.do

# Rate Limiting (Optional - for production)
# Leave these empty for now - rate limiting will be disabled
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server URL (Required for unsubscribe links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000