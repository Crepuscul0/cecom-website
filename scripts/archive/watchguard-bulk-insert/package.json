{
  "name": "watchguard-bulk-insert",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Portable bundle to bulk insert WatchGuard catalog into Supabase",
  "scripts": {
    "start": "node bulk-insert-products.js --file=data/scraped/watchguard/watchguard-catalog.json",
    "dry": "node bulk-insert-products.js --file=data/scraped/watchguard/watchguard-catalog.json --limit=50 --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.2.1"
  }
}
